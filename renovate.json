{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "configMigration": true,
  "baseBranchPatterns": ["dev"],
  "schedule": ["before 9am on monday"],
  "timezone": "America/Los_Angeles",
  "automerge": false,
  "prConcurrentLimit": 3,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["aquasecurity/trivy"],
      "overrideDatasource": "git-tags",
      "overridePackageName": "https://github.com/aquasecurity/trivy.git"
    },
    { "matchPackageNames": ["tar"], "groupName": "archive handling" },
    { "matchDepTypes": ["devDependencies"], "matchUpdateTypes": ["patch", "minor"], "groupName": "development dependencies" }
  ]
}
